<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Разряд — тренажёр систем счисления</title>
<meta name="theme-color" content="#e9ecf8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1030" media="(prefers-color-scheme: dark)">
<meta name="description" content="Тренажёр по системам счисления для старшей школы: двоичная, 4-, 8-, 16-ричная и любые основания до 16.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Разряд">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icons/icon.svg" type="image/svg+xml">
<link rel="icon" href="icons/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Manrope:wght@500;600;700;800&family=Unbounded:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{
  --ui:'Manrope',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Consolas,monospace;
  --disp:'Unbounded','Manrope',system-ui,sans-serif;

  --bg:#e9ecf8; --bg2:#dfe3f4; --panel:#ffffff; --well:#dde2f5; --line:rgba(40,52,140,.10);
  --ink:#191b3a; --ink2:#50557f; --muted:#8d92b8;
  --tile:#ffffff; --tile-b:rgba(35,45,120,.13);
  --bin:#0b9c97; --hex:#6d3ff0; --oct:#d67a04; --quad:#15963f; --arb:#d81b60;
  --ok:#0ea371; --bad:#e23b3b; --brand:#4338ca;
  --key:#ffffff; --shade:rgba(25,30,90,.14);
  color-scheme:light;

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0e1030; --bg2:#171a44; --panel:#1a1d4a; --well:#11143a; --line:rgba(150,160,255,.09);
    --ink:#eef0ff; --ink2:#aab0de; --muted:#6c72a8;
    --tile:#212558; --tile-b:rgba(160,170,255,.14);
    --bin:#2ee0cf; --hex:#a98bff; --oct:#ffc23d; --quad:#57e38a; --arb:#ff6f9a;
    --ok:#3ee6a4; --bad:#ff5d5d; --brand:#8b8cff;
    --key:#232760; --shade:rgba(0,0,0,.35);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0e1030; --bg2:#171a44; --panel:#1a1d4a; --well:#11143a; --line:rgba(150,160,255,.09);
  --ink:#eef0ff; --ink2:#aab0de; --muted:#6c72a8;
  --tile:#212558; --tile-b:rgba(160,170,255,.14);
  --bin:#2ee0cf; --hex:#a98bff; --oct:#ffc23d; --quad:#57e38a; --arb:#ff6f9a;
  --ok:#3ee6a4; --bad:#ff5d5d; --brand:#8b8cff;
  --key:#232760; --shade:rgba(0,0,0,.35);
  color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:var(--bg);
  background-image:radial-gradient(120% 60% at 50% -10%, color-mix(in srgb,var(--brand) 16%,transparent), transparent 60%);
  color:var(--ink);font-family:var(--ui);
  overflow:hidden;overscroll-behavior:none;touch-action:manipulation;
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;
}
button{font:inherit;color:inherit}
button:focus-visible{outline:3px solid var(--brand);outline-offset:2px}

.fam-bin{--acc:var(--bin)} .fam-hex{--acc:var(--hex)} .fam-oct{--acc:var(--oct)}
.fam-quad{--acc:var(--quad)} .fam-arb{--acc:var(--arb)}

#app{height:100%;max-width:560px;margin:0 auto;display:flex;flex-direction:column;padding:0 10px}

/* HUD */
.hud{display:flex;align-items:center;gap:8px;padding:10px 2px 6px}
.logo{font:800 17px/1 var(--disp);letter-spacing:.02em;margin-right:auto;display:flex;align-items:center;gap:6px}
.logo b{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:6px;background:var(--bin);color:#fff;font:800 13px var(--mono)}
.logo b+b{background:var(--hex)}
.stat{display:flex;flex-direction:column;align-items:flex-end;min-width:48px}
.stat span{font-size:11px;color:var(--muted);font-weight:600}
.stat strong{font:800 18px/1.1 var(--mono)}
.stat.combo strong{color:var(--oct)}
.ibtn{width:38px;height:38px;border-radius:12px;border:1px solid var(--tile-b);background:var(--panel);display:grid;place-items:center;cursor:pointer;flex:none}
.ibtn svg{width:18px;height:18px}
.lvlbar{height:5px;border-radius:3px;background:var(--bg2);overflow:hidden;margin:0 2px 8px}
.lvlbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--bin),var(--hex));border-radius:3px;transition:width .4s}
@media (max-width:420px){ .logo span{display:none} .stat{min-width:40px} .stat strong{font-size:16px} }

/* Well */
.stage{flex:1;min-height:0;display:flex}
.well{
  position:relative;flex:1;overflow:hidden;
  background:linear-gradient(180deg, color-mix(in srgb,var(--well) 55%,transparent), var(--well));
  border:3px solid color-mix(in srgb,var(--ink2) 26%,transparent);border-top:0;
  border-radius:4px 4px 22px 22px;
  --tile-h:62px;--sq:26px;--pad:8px;
}
.well.danger{animation:danger 1s ease-in-out infinite}
@keyframes danger{50%{border-color:var(--bad);box-shadow:inset 0 0 40px color-mix(in srgb,var(--bad) 22%,transparent)}}
.guide{position:absolute;left:var(--pad);right:var(--pad);height:var(--tile-h);border:1.5px dashed var(--line);border-radius:14px}
.guide.top{border-color:color-mix(in srgb,var(--bad) 35%,transparent);background:color-mix(in srgb,var(--bad) 5%,transparent)}
#tiles,#fx{position:absolute;inset:0}
#fx{pointer-events:none;z-index:5}

.tile{position:absolute;left:var(--pad);right:var(--pad);top:0;height:var(--tile-h);will-change:transform;cursor:pointer}
.card{
  position:relative;height:100%;display:flex;align-items:center;justify-content:center;gap:10px;padding:0 12px 0 16px;
  border-radius:14px;background:var(--tile);border:1px solid var(--tile-b);
  box-shadow:0 2px 0 var(--shade),0 8px 20px -10px var(--shade);
  transition:box-shadow .2s,border-color .2s,opacity .2s;overflow:hidden;opacity:.9;
}
.card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--acc)}
.card.w{padding-top:11px}
.tile.new .card{animation:pop .2s ease-out}
@keyframes pop{from{opacity:0}}
.tile.active .card{opacity:1;border-color:var(--acc);box-shadow:0 0 0 2px var(--acc),0 10px 28px -8px color-mix(in srgb,var(--acc) 60%,transparent)}
.tile.ok .card{opacity:1;border-color:var(--ok);box-shadow:0 0 0 2px var(--ok),0 0 32px color-mix(in srgb,var(--ok) 45%,transparent)}
.tile.ok .a{color:var(--ok)}
.tile.ok .in .sq.one{background:var(--ok);border-color:var(--ok)}
.tile.vanish .card{animation:vanish .42s ease-in forwards}
@keyframes vanish{to{opacity:0;transform:translateY(22px) scale(.9);filter:blur(5px)}}
.tile.shake .card{animation:shake .38s}
@keyframes shake{20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
.tile.nope .field{border-color:var(--bad)}
.tile.dead .card{filter:grayscale(1);opacity:.45;transition:filter .5s,opacity .5s;transition-delay:inherit}

.q,.a{flex:0 1 auto;min-width:0;display:flex;align-items:center}
.eq{flex:none;font:700 22px var(--mono);color:var(--muted)}
.num{font:700 22px/1 var(--mono);letter-spacing:.02em;white-space:nowrap}
sub{font:700 12px/1 var(--mono);color:var(--ink2);position:relative;top:.55em;margin-left:2px;vertical-align:baseline}

.field{position:relative;display:inline-flex;align-items:center;min-width:1.8em;height:38px;padding:0 10px;cursor:text;
  border-bottom:2.5px solid var(--muted);border-radius:8px 8px 0 0;
  background:color-mix(in srgb,var(--acc) 10%,transparent);font:700 22px/1 var(--mono);transition:border-color .2s}
.field .ph{color:var(--muted);position:absolute;left:0;right:0;text-align:center}
.caret{display:none;width:2px;height:24px;margin:0 -1px;background:var(--acc);animation:blink 1s steps(1) infinite}
.dg{display:inline-block;padding:0 .5px}
.rep{position:absolute;bottom:3px;left:14px;font:700 9px/1 var(--ui);color:var(--muted)}
.tile.active .field{border-color:var(--acc)}
.tile.active .field .ph{display:none}
.tile.active:not(.ok) .caret{display:block}
@keyframes blink{50%{opacity:0}}

.bits{display:flex;align-items:center;gap:3px;min-width:0}
.sq{position:relative;flex:0 1 var(--sq);width:var(--sq);aspect-ratio:1/1;min-width:13px;
  display:grid;place-items:center;border-radius:6px;font:700 calc(var(--sq)*.58)/1 var(--mono)}
.sq.gap{margin-left:8px}
.sq em{position:absolute;bottom:calc(100% + 2px);left:50%;transform:translateX(-50%);font:600 8.5px/1 var(--ui);font-style:normal;color:var(--muted);white-space:nowrap}
.ro .sq.one{background:color-mix(in srgb,var(--acc) 22%,var(--tile));border:1.5px solid color-mix(in srgb,var(--acc) 70%,transparent)}
.ro .sq.zero{border:1.5px solid var(--tile-b);color:var(--ink2)}
.ro .sq.pad{opacity:.45;border-style:dashed}
.in .sq{cursor:pointer;transition:background .12s,transform .12s}
.in .sq.zero{border:1.5px solid color-mix(in srgb,var(--acc) 45%,var(--tile-b));background:var(--bg2);color:var(--muted)}
.in .sq.one{background:var(--acc);border:1.5px solid var(--acc);color:#fff}
.in .sq:active{transform:scale(.9)}
.in .sq.ghost{border:1.5px dashed var(--muted);opacity:.7;place-items:end start;padding:0 0 3px 3px}
.in .sq.ghost sub{top:0;margin:0;font-size:10px;color:var(--muted)}
.tile.active .sq.ghost{border-color:var(--acc);animation:gp 1.2s ease-in-out infinite}
@keyframes gp{50%{background:color-mix(in srgb,var(--acc) 16%,transparent)}}

/* FX */
.fl{position:absolute;right:22px;font:800 20px var(--ui);color:var(--ok);animation:up .95s ease-out forwards;text-shadow:0 2px 8px var(--shade)}
.fl.bad{color:var(--bad)}
.fl.big{right:auto;left:0;width:100%;text-align:center;font:800 22px var(--disp);color:var(--oct)}
@keyframes up{from{opacity:0;transform:translateY(8px)}20%{opacity:1}to{opacity:0;transform:translateY(-38px)}}
.bit{position:absolute;font:800 13px var(--mono);color:var(--acc);animation:burst .75s ease-out forwards}
@keyframes burst{to{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(160deg)}}
.banner{position:absolute;left:14px;right:14px;top:22%;z-index:6;text-align:center;pointer-events:none;opacity:0}
.banner.go{animation:ban 3.2s ease forwards}
.banner h3{margin:0 0 6px;font:800 30px/1.1 var(--disp);color:var(--ink)}
.banner p{margin:0 auto;max-width:34ch;font:600 15px/1.4 var(--ui);color:var(--ink2);background:color-mix(in srgb,var(--panel) 85%,transparent);padding:8px 12px;border-radius:12px}
@keyframes ban{0%{opacity:0;transform:translateY(10px)}10%,80%{opacity:1;transform:none}100%{opacity:0;transform:translateY(-10px)}}

/* Keypad */
.keypad{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:10px 0 10px}
.k{height:46px;border-radius:12px;border:1px solid var(--tile-b);background:var(--key);box-shadow:0 2px 0 var(--shade);
  font:700 20px var(--mono);cursor:pointer;touch-action:manipulation;transition:opacity .15s,transform .06s}
.k.hx{color:var(--hex)}
.k.wide{grid-column:span 2}
.k.go{background:var(--ok);border-color:var(--ok);color:#fff}
.k.bs{color:var(--ink2)}
.k.press{transform:translateY(2px);box-shadow:none}
.k.off{opacity:.22;pointer-events:none}
.khint{display:none;text-align:center;font-size:12px;color:var(--muted);padding:0 0 10px}
@media (hover:hover) and (pointer:fine){ .k{height:40px;font-size:18px} .khint{display:block} }
@media (max-height:640px){ .k{height:40px} .hud{padding-top:6px} }

/* Overlays */
.ov{position:fixed;inset:0;z-index:20;display:none;place-items:center;padding:calc(env(safe-area-inset-top,0px) + 14px) 14px calc(env(safe-area-inset-bottom,0px) + 14px);
  background:color-mix(in srgb,var(--bg) 72%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.ov.show{display:grid}
.panel{width:min(520px,100%);max-height:100%;overflow:auto;background:var(--panel);border:1px solid var(--tile-b);border-radius:22px;padding:22px;box-shadow:0 30px 60px -20px var(--shade);-webkit-user-select:text;user-select:text}
.panel h2{font:800 26px/1.15 var(--disp);margin:0 0 6px}
.panel h4{font:700 15px var(--ui);margin:22px 0 8px}
.panel p{color:var(--ink2);line-height:1.5;margin:0 0 12px}
.hero{display:flex;gap:5px;margin:4px 0 16px}
.hero span{flex:1;aspect-ratio:1;max-width:44px;border-radius:9px;display:grid;place-items:center;font:800 20px var(--mono);color:#fff}
.hero span:nth-child(odd){background:var(--bin)} .hero span:nth-child(even){background:var(--hex)}
.hero span.z{background:transparent;border:2px solid var(--tile-b);color:var(--muted)}
.rules{margin:0 0 16px;padding:0;list-style:none;display:grid;gap:8px}
.rules li{display:flex;gap:10px;align-items:flex-start;color:var(--ink2);line-height:1.4;font-size:15px}
.rules li i{flex:none;width:8px;height:8px;border-radius:2px;margin-top:6px;background:var(--acc)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 18px}
.chip{min-width:40px;height:38px;border-radius:10px;border:1.5px solid var(--tile-b);background:transparent;font:700 15px var(--mono);cursor:pointer}
.chip.on{background:var(--brand);border-color:var(--brand);color:#fff}
.row{display:flex;gap:8px;flex-wrap:wrap}
.btn{flex:1;min-width:140px;height:50px;border-radius:14px;border:0;background:var(--brand);color:#fff;font:800 16px var(--ui);cursor:pointer;box-shadow:0 3px 0 color-mix(in srgb,var(--brand) 55%,#000)}
.btn.alt{background:var(--bg2);color:var(--ink);box-shadow:0 3px 0 var(--shade)}
.btn:active{transform:translateY(2px);box-shadow:none}
.big{font:800 48px/1 var(--mono);margin:10px 0 4px}
.badge{display:inline-block;padding:4px 10px;border-radius:999px;background:var(--oct);color:#1a1300;font:800 13px var(--ui);margin-bottom:8px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0 14px}
.cell{background:var(--bg2);border-radius:12px;padding:10px}
.cell strong{display:block;font:800 18px var(--mono)}
.cell span{font-size:12px;color:var(--muted);font-weight:600}
.note{background:color-mix(in srgb,var(--oct) 14%,transparent);border-radius:12px;padding:10px 12px;color:var(--ink);font-size:14px;line-height:1.45;margin:0 0 14px}

.ch{width:100%;height:auto;display:block}
.ch .grid line{stroke:var(--line);stroke-width:1}
.ch text{fill:var(--muted);font:600 10px var(--ui)}
.ch path{fill:none;stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round}
.ch .s1{stroke:var(--brand)} .ch .s2{stroke:var(--oct);stroke-dasharray:4 4;stroke-width:2}
.ch .s3{stroke:var(--bin)} .ch circle.s1{fill:var(--brand);stroke:none} .ch circle.s3{fill:var(--bin);stroke:none}
.ch .area{fill:color-mix(in srgb,var(--brand) 14%,transparent);stroke:none}
.ch rect{fill:var(--bin)} .ch rect.zero{fill:var(--line)}
.legend{display:flex;gap:14px;font-size:12px;color:var(--ink2);margin:4px 0 0}
.legend i{display:inline-block;width:14px;height:3px;border-radius:2px;vertical-align:middle;margin-right:5px}
.sk{display:grid;grid-template-columns:minmax(96px,1.2fr) 1.3fr 42px 70px;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);font-size:14px}
.sk:last-child{border:0}
.sk-n{font:700 13px var(--mono)}
.sk-b{height:8px;border-radius:4px;background:var(--bg2);overflow:hidden}
.sk-b i{display:block;height:100%;background:var(--bin);border-radius:4px}
.sk-a{font:700 13px var(--mono);text-align:right}
.sk-t{font:600 13px var(--mono);text-align:right;color:var(--ink2)}
.tr{font-size:11px;margin-left:2px} .tr.up{color:var(--ok)} .tr.dn{color:var(--bad)}
.empty{color:var(--muted);font-size:14px;padding:6px 0}
.linkbtn{background:none;border:0;color:var(--bad);font-weight:700;cursor:pointer;padding:8px 0;margin-top:10px}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>
<div id="app">
  <header class="hud">
    <div class="logo"><b>1</b><b>0</b><span>Разряд</span></div>
    <div class="stat"><span>Уровень</span><strong id="hLvl">1</strong></div>
    <div class="stat"><span>Очки</span><strong id="hScore">0</strong></div>
    <div class="stat combo"><span>Серия</span><strong id="hCombo">×1.0</strong></div>
    <button class="ibtn" id="bPause" aria-label="Пауза"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1.5"/><rect x="14" y="5" width="4" height="14" rx="1.5"/></svg></button>
    <button class="ibtn" id="bStats" aria-label="Прогресс"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16M8 15l4-5 3 3 5-7"/></svg></button>
  </header>
  <div class="lvlbar"><i id="hBar"></i></div>
  <main class="stage">
    <div class="well" id="well">
      <div id="guides"></div>
      <div id="tiles"></div>
      <div id="fx"></div>
      <div class="banner" id="banner"><h3></h3><p></p></div>
    </div>
  </main>
  <div class="keypad" id="keypad"></div>
  <div class="khint">↑ ↓ — выбрать плашку · 0–9, A–F — ввод · Enter — проверить · Esc — пауза</div>
</div>

<div class="ov" id="ovStart"><div class="panel">
  <div class="hero"><span>1</span><span class="z">0</span><span>1</span><span>1</span><span class="z">0</span><span>1</span></div>
  <h2>Разряд</h2>
  <p>Тренажёр по системам счисления. Переводи числа, пока стакан не заполнился.</p>
  <ul class="rules">
    <li class="fam-bin"><i></i>Набери ответ — подтверждать не нужно: верный ответ засчитается сам.</li>
    <li class="fam-hex"><i></i>Плашку выбирай тапом или стрелками ↑ ↓. Двоичные ответы можно ставить тапом по квадратикам.</li>
    <li class="fam-oct"><i></i>Быстрые ответы и серия без ошибок дают больше очков. Enter проверяет ответ, но за ошибку снимает очки.</li>
    <li class="fam-arb"><i></i>Каждые 8 решённых задач — новый уровень.</li>
  </ul>
  <h4>Начать с уровня</h4>
  <div class="chips" id="chips"></div>
  <div class="row"><button class="btn" id="bPlay" data-primary>Играть</button><button class="btn alt" data-stats>Мой прогресс</button></div>
</div></div>

<div class="ov" id="ovPause"><div class="panel">
  <h2>Пауза</h2>
  <p id="pInfo"></p>
  <div class="row"><button class="btn" id="bResume" data-primary>Продолжить</button><button class="btn alt" id="bRestart">Новая игра</button></div>
  <div class="row" style="margin-top:8px"><button class="btn alt" data-stats>Мой прогресс</button></div>
</div></div>

<div class="ov" id="ovOver"><div class="panel">
  <h2>Стакан заполнен</h2>
  <div id="oBadge"></div>
  <div class="big" id="oScore">0</div>
  <p>очков</p>
  <div class="grid3" id="oGrid"></div>
  <div id="oNote"></div>
  <div class="row"><button class="btn" id="bAgain" data-primary>Новая игра</button><button class="btn alt" data-stats>Мой прогресс</button></div>
</div></div>

<div class="ov" id="ovStats"><div class="panel">
  <h2>Мой прогресс</h2>
  <div id="statsBody"></div>
  <div class="row" style="margin-top:16px"><button class="btn" id="bBack" data-primary>Назад</button></div>
  <button class="linkbtn" id="bReset">Стереть историю</button>
</div></div>

<script>
(() => {
'use strict';
const $ = s => document.querySelector(s);
const KEY = 'razryad.v1', GOAL = 8, DIG = '0123456789ABCDEF';
const SPAWN_DROP = 36, SPAWN_TIME = .2; // появление: короткий сдвиг вниз за 200 мс
const POW = [4, 8, 16], ARB = [3, 5, 6, 7, 9, 11, 12, 13, 14, 15];
const CATS = {b2d:'2 → 10', d2b:'10 → 2', b2p:'2 → 4, 8, 16', p2b:'4, 8, 16 → 2', p2d:'4, 8, 16 → 10',
  d2p:'10 → 4, 8, 16', p2p:'4 ↔ 8 ↔ 16', a2d:'любая → 10', d2a:'10 → любая'};
const CAT_LVL = {b2d:1, d2b:2, b2p:7, p2b:7, p2d:10, d2p:11, a2d:13, d2a:14, p2p:15};
const WEIGHT = {b2d:10, d2b:10, b2p:8, p2b:8, p2d:14, d2p:16, p2p:18, a2d:18, d2a:22};

// ---------- Levels ----------
const LEVELS = [
  {desc:'Переводи двоичные числа в десятичные. Над разрядами подписаны их веса. Числа до 7.',
   pairs:[[2,10]], bits:[2,3], bin:'fixed', hint:true, weights:true, spawn:9},
  {desc:'Теперь и обратно. Тапай по квадратикам или набирай 0 и 1 — биты въезжают справа. Числа до 15.',
   pairs:[[2,10],[10,2]], bits:[3,4], bin:'fixed', hint:true, weights:true, spawn:9},
  {desc:'Пять бит: числа до 31.',
   pairs:[[2,10],[10,2]], bits:[4,5], bin:'fixed', hint:true, weights:true, spawn:10},
  {desc:'Шесть бит: числа до 63.',
   pairs:[[2,10],[10,2]], bits:[5,6], bin:'fixed', hint:true, weights:true, spawn:10},
  {desc:'Семь бит: числа до 127.',
   pairs:[[2,10],[10,2]], bits:[6,7], bin:'fixed', hint:true, weights:true, spawn:11},
  {desc:'Целый байт: числа до 255.',
   pairs:[[2,10],[10,2]], bits:[7,8], bin:'fixed', hint:true, weights:true, spawn:11},
  {desc:'Шестнадцатеричная система. Разбивай биты на четвёрки справа налево.',
   pairs:[[2,16],[16,2],[2,16],[16,2],[2,10],[10,2]], bits:[5,8], bin:'fixed', hint:true, weights:false, spawn:10},
  {desc:'Восьмеричная система: группы по три бита.',
   pairs:[[2,8],[8,2],[2,8],[8,2],[2,16],[16,2]], bits:[5,8], bin:'fixed', hint:true, weights:false, spawn:10},
  {desc:'Четверичная система: группы по два бита.',
   pairs:[[2,4],[4,2],[2,4],[4,2],[2,8],[8,2],[2,16],[16,2]], bits:[5,8], bin:'fixed', hint:true, weights:false, spawn:9.5},
  {desc:'Из 4-, 8- и 16-ричной — в десятичную. Двоичный ответ теперь набирается без ведущих нулей.',
   pairs:[[16,10],[8,10],[4,10],[10,2],[2,16]], bits:[5,8], bin:'free', hint:true, weights:false, spawn:11},
  {desc:'Из десятичной — в 8- и 16-ричную.',
   pairs:[[10,16],[10,8],[16,10],[8,10],[16,2],[8,2]], bits:[5,8], bin:'free', hint:true, weights:false, spawn:11},
  {desc:'Разделителей больше нет — группируй биты в уме. Числа до 511.',
   pairs:[[2,16],[16,2],[2,8],[8,2],[2,4],[4,2],[10,16],[16,10]], bits:[6,9], bin:'free', hint:false, weights:false, spawn:10},
  {desc:'Любые основания от 3 до 16 — в десятичную.',
   pairs:[['A',10],['A',10],[16,10],[10,2]], bits:[4,7], bin:'free', hint:false, weights:false, spawn:13},
  {desc:'Из десятичной — в любое основание. Дели с остатком!',
   pairs:[[10,'A'],[10,'A'],['A',10],[10,16]], bits:[4,7], bin:'free', hint:false, weights:false, spawn:13},
  {desc:'Между 4-, 8- и 16-ричной — через двоичную запись.',
   pairs:[['P','P'],['P','P'],['A',10],[10,'A'],[2,16],[16,2]], bits:[5,9], bin:'free', hint:false, weights:false, spawn:12},
  {desc:'Мастер: всё сразу, числа до 1023.',
   pairs:[[2,10],[10,2],[2,'P'],['P',2],['P',10],[10,'P'],['P','P'],['A',10],[10,'A']], bits:[6,10], bin:'free', hint:false, weights:false, spawn:11},
];
function cfg(l){
  if (l <= LEVELS.length) return LEVELS[l-1];
  const c = LEVELS[LEVELS.length-1], k = l - LEVELS.length;
  return {...c, desc:'Скорость растёт!', spawn:Math.max(5, c.spawn*Math.pow(.93,k))};
}

// ---------- Storage ----------
const defStore = () => ({v:1, games:[], best:0, maxLevel:1});
function loadStore(){
  try { const s = JSON.parse(localStorage.getItem(KEY)); if (s && Array.isArray(s.games)) return Object.assign(defStore(), s); } catch(e){}
  return defStore();
}
function saveStore(){ try { localStorage.setItem(KEY, JSON.stringify(store)); } catch(e){} }
let store = loadStore();

// ---------- DOM ----------
const wellEl = $('#well'), tilesEl = $('#tiles'), fxEl = $('#fx'), guidesEl = $('#guides');
const G = {W:0, H:0, tileH:62, gap:6, pad:8, cap:6};
function measure(){
  const r = wellEl.getBoundingClientRect();
  G.W = r.width; G.H = r.height;
  G.tileH = G.W < 400 ? 54 : 62;
  if (G.H < 330) G.tileH = 50;
  wellEl.style.setProperty('--tile-h', G.tileH + 'px');
  wellEl.style.setProperty('--sq', (G.W < 400 ? 22 : 26) + 'px');
  G.cap = Math.max(3, Math.floor((G.H - 2*G.pad + G.gap) / (G.tileH + G.gap)));
  let h = '';
  for (let i = 0; i < G.cap; i++) h += `<div class="guide${i === G.cap-1 ? ' top' : ''}" style="top:${slotY(i)}px"></div>`;
  guidesEl.innerHTML = h;
}
const slotY = s => G.H - G.pad - G.tileH - s*(G.tileH + G.gap);
new ResizeObserver(measure).observe(wellEl);

// ---------- Helpers ----------
const pick = a => a[Math.floor(Math.random()*a.length)];
const rint = (a, b) => a + Math.floor(Math.random()*(b-a+1));
const res = b => b === 'A' ? pick(ARB) : b === 'P' ? pick(POW) : b;
const isP = b => POW.includes(b);
function catOf(f, t){
  if (f===2 && t===10) return 'b2d'; if (f===10 && t===2) return 'd2b';
  if (f===2 && isP(t)) return 'b2p'; if (isP(f) && t===2) return 'p2b';
  if (isP(f) && t===10) return 'p2d'; if (f===10 && isP(t)) return 'd2p';
  if (isP(f) && isP(t)) return 'p2p'; return t===10 ? 'a2d' : 'd2a';
}
function famOf(f, t){
  const std = [2,4,8,10,16];
  if (!std.includes(f) || !std.includes(t)) return 'arb';
  if (f===16 || t===16) return 'hex'; if (f===8 || t===8) return 'oct'; if (f===4 || t===4) return 'quad';
  return 'bin';
}
function groupOf(f, t){
  if (f!==2 && t!==2) return 0;
  return ({4:2, 8:3, 16:4})[f===2 ? t : f] || 0;
}
const gapAt = (i, n, g) => g && i > 0 && (n - i) % g === 0;
const vibrate = ms => { try { navigator.vibrate && navigator.vibrate(ms); } catch(e){} };
const fmtT = s => s < 10 ? s.toFixed(1) : Math.round(s).toString();

// ---------- Game state ----------
let S = null, tiles = [], activeId = null, uid = 0, gid = 0, startLevel = 1, overlay = null, prevOverlay = null;

function newState(level){
  return {id:++gid, level, startLevel:level, lvlSolved:0, score:0, combo:0, bestCombo:0, solved:0, errors:0,
    times:[], cats:{}, recent:[], seen:new Set(), repeatQ:[], spawned:0, stage:1, stageCnt:{}, dprog:{}, t:0, nextSpawn:.3, running:true, over:false, peak:0, saved:false, started:Date.now()};
}
const catStat = c => S.cats[c] || (S.cats[c] = {n:0, e:0, t:0});

function makeTask(){
  const c = cfg(S.level);
  S.spawned++;
  // повтор задач, где была ошибка или ученик долго думал
  let f, t;
  do { const p = pick(c.pairs); f = res(p[0]); t = res(p[1]); } while (f === t);
  return buildTask(c, f, t, genValue(c, f, t), false);
}
const popc = v => { let k = 0; while (v){ k += v & 1; v >>>= 1; } return k; };
// Генерация числа:
//  * старший (новый для уровня) бит равен 1 с вероятностью 60%;
//  * «ступень» S.stage — желаемое число единиц: растёт с каждым верным ответом, падает при ошибке;
//  * на каждой ступени сначала единицы стоят справа (младшие разряды), потом разбегаются влево;
//  * числа не повторяются, пока есть из чего выбирать.
const workBase = (f, t) => (f === 2 || t === 2) ? 2 : (f !== 10 ? f : t);
function advance(t, d){
  const c = cfg(S.level), B = workBase(t.from, t.to);
  if (B === 2) S.stage = Math.max(1, Math.min(c.bits[1], S.stage + d));
  else { const L = digitLadder(B, 2 ** c.bits[1] - 1); S.dprog[B] = Math.max(0, Math.min(L.length, (S.dprog[B] || 0) + d)); }
}
// Лестница для оснований, отличных от 2: сначала двузначные числа со старшей цифрой 1,
// затем старшая цифра растёт; потом трёхзначные — снова со старшей 1, и т.д.
function digitLadder(B, hi){
  const steps = [], caps = [];
  for (let x = 1; x <= Math.min(3, B - 1); x++) caps.push(x);
  if (B - 1 > 3){ const m = Math.ceil((B - 4) / 3); for (let j = 1; j <= m; j++) caps.push(3 + Math.round((B - 4) * j / m)); }
  for (let d = 2; B ** (d - 1) <= hi; d++){
    let prev = 0;
    for (const cap of caps){
      if (B ** (d - 1) * (prev + 1) > hi) break;
      steps.push({d, lo:prev + 1, hi:cap}); prev = cap;
    }
  }
  return steps;
}
function pickFrom(lo, hi, f, t, strict){
  const busy = new Set(tiles.map(x => x.v)), recent = new Set(S.recent.slice(-12));
  const levels = [[1, 1], [0, 1], [0, 0]];
  for (const [seen, rec] of levels){
    const cand = [];
    for (let v = Math.max(2, lo); v <= hi; v++){
      if (busy.has(v) || v.toString(f) === v.toString(t)) continue;
      if (rec && recent.has(v)) continue;
      if (seen && S.seen.has(v)) continue;
      cand.push(v);
    }
    if (cand.length) return pick(cand);
  }
  return strict ? null : rint(Math.max(2, lo), hi);
}
function genValue(c, f, t){
  const B = workBase(f, t);
  if (B !== 2){
    const hi = 2 ** c.bits[1] - 1, L = digitLadder(B, hi), i = S.dprog[B] || 0;
    if (i < L.length){
      const st = L[i], p = B ** (st.d - 1);
      // обычно — новая старшая цифра ступени, иногда — любая из пройденных
      const lead = Math.random() < .25 ? [1, st.hi] : [st.lo, st.hi];
      const v = pickFrom(p * lead[0], Math.min(hi, p * (lead[1] + 1) - 1), f, t, true);
      if (v != null) return v;
    }
    return pickFrom(B, hi, f, t, false);
  }
  return genBinary(c, f, t);
}
function genBinary(c, f, t){
  const n = c.bits[1], hi = 2 ** n - 1, top = 2 ** (n - 1), bin = f === 2 || t === 2;
  const k = S.stage >= n ? rint(Math.ceil(n / 2), n) : S.stage, cnt = S.stageCnt[k] || 0;
  S.stageCnt[k] = cnt + 1;
  const beta = Math.max(0, .9 - .3 * cnt);
  const wantTop = Math.random() < .6;
  const busy = new Set(tiles.map(x => x.v));
  const recent = new Set(S.recent.slice(-Math.min(12, Math.floor((hi - 1) / 2))));
  const steps = [{top:1, seen:1, rec:1}, {top:0, seen:1, rec:1}, {top:0, seen:0, rec:1}, {top:0, seen:0, rec:0}];
  for (const L of steps){
    const cand = [], w = [];
    for (let v = 2; v <= hi; v++){
      if (busy.has(v) || v.toString(f) === v.toString(t)) continue;
      if (L.rec && recent.has(v)) continue;
      if (L.seen && S.seen.has(v)) continue;
      if (L.top && ((v & top) !== 0) !== wantTop) continue;
      let wt = 1;
      if (bin){
        wt = Math.exp(-4 * Math.abs(popc(v) - k));
        let sum = 0, m = 0;
        for (let i = 0; i < n - 1; i++) if ((v >> i) & 1){ sum += i; m++; }
        if (m) wt *= Math.exp(-beta * sum / m);
      }
      cand.push(v); w.push(wt);
    }
    if (cand.length){
      let r = Math.random() * w.reduce((a, b) => a + b, 0);
      for (let i = 0; i < cand.length; i++){ r -= w[i]; if (r <= 0) return cand[i]; }
      return cand[cand.length - 1];
    }
  }
  return rint(2, hi);
}
function buildTask(c, f, t, v, rep){
  S.recent.push(v); if (S.recent.length > 40) S.recent.shift();
  S.seen.add(v);
  const q = v.toString(f).toUpperCase(), ans = v.toString(t).toUpperCase();
  const mode = t === 2 ? c.bin : 'text';
  const width = mode === 'fixed' ? Math.max(c.bits[1], ans.length) : 0;
  return {id:++uid, from:f, to:t, v, q, ans, mode, width, rep,
    bits: mode === 'fixed' ? new Array(width).fill(0) : null, text:'', cur:0,
    hint:c.hint, weights: c.weights && (f === 2 || t === 2), group:groupOf(f, t),
    cat:catOf(f, t), fam:famOf(f, t), maxF: Math.min(12, c.bits[1] + 2),
    born:S.t, think:0, wrong:0, helped:false, slot:0, y:0, fallV:0, dropping:true, state:'live', el:null};
}

// ---------- Rendering ----------
function leftHTML(t){
  if (t.from === 2){
    const g = t.hint ? t.group : 0;
    const pad = g ? (g - t.q.length % g) % g : 0;
    const ds = ('0'.repeat(pad) + t.q).split(''), n = ds.length;
    return `<span class="bits ro">${ds.map((d, i) =>
      `<span class="sq ${d==='1'?'one':'zero'}${i<pad?' pad':''}${gapAt(i,n,g)?' gap':''}">${t.weights?`<em>${2**(n-1-i)}</em>`:''}${d}</span>`
    ).join('')}</span><sub>2</sub>`;
  }
  return `<span class="num">${t.q}</span>${t.from !== 10 ? `<sub>${t.from}</sub>` : ''}`;
}
function ansHTML(t){
  const g = t.hint ? t.group : 0;
  if (t.mode === 'text')
  {
    const ds = t.text.split('').map((d, i) => `<span class="dg" data-c="${i}">${d}</span>`);
    ds.splice(t.cur, 0, '<i class="caret"></i>');
    return `<span class="field">${t.text ? '' : '<span class="ph">?</span>'}${ds.join('')}</span><sub>${t.to}</sub>`;
  }
  if (t.mode === 'fixed'){
    const n = t.width;
    return `<span class="bits in">${t.bits.map((b, i) =>
      `<span class="sq ${b?'one':'zero'}${gapAt(i,n,g)?' gap':''}" data-i="${i}">${t.weights?`<em>${2**(n-1-i)}</em>`:''}${b}</span>`
    ).join('')}</span><sub>2</sub>`;
  }
  const ds = t.text.split(''), n = ds.length, full = n >= t.maxF;
  let h = ds.map((d, i) => `<span class="sq ${d==='1'?'one':'zero'}${gapAt(i,n,g)?' gap':''}" data-i="${i}">${d}</span>`).join('');
  if (!full) h += `<span class="sq ghost" data-ghost="1"><sub>2</sub></span>`;
  return `<span class="bits in">${h}</span>${full ? '<sub>2</sub>' : ''}`;
}
function render(t){
  const card = t.el.firstChild;
  card.className = 'card fam-' + t.fam + (t.weights ? ' w' : '');
  card.innerHTML = (t.rep ? '<span class="rep" title="Повтор">↻ повтор</span>' : '') + `<div class="q">${leftHTML(t)}</div><div class="eq">=</div><div class="a">${ansHTML(t)}</div>`;
}

// ---------- Selection & input ----------
const act = () => tiles.find(t => t.id === activeId && t.state === 'live') || null;
function setActive(t){
  activeId = t ? t.id : null;
  for (const x of tiles) x.el.classList.toggle('active', x.id === activeId);
  updateKeys();
}
function moveSel(dir){
  const live = tiles.filter(t => t.state === 'live');
  if (!live.length) return;
  const cur = act();
  if (!cur){ setActive(live[0]); return; }
  const i = live.indexOf(cur), j = Math.max(0, Math.min(live.length-1, i + dir));
  setActive(live[j]);
}
function pickNext(from){
  const live = tiles.filter(t => t.state === 'live' && t !== from);
  if (!live.length){ setActive(null); return; }
  live.sort((a, b) => (Math.abs(a.slot - from.slot) - Math.abs(b.slot - from.slot)) || (b.slot - a.slot));
  setActive(live[0]);
}
function isCorrect(t){
  if (t.mode === 'fixed') return t.bits.reduce((a, b) => a*2 + b, 0) === t.v;
  return t.text !== '' && parseInt(t.text, t.to) === t.v;
}
function changed(t){ render(t); if (isCorrect(t)) lock(t); }

function inputDigit(d){
  if (!S || !S.running) return;
  const t = act(); if (!t) return;
  if (d >= t.to){ nope(t); return; }
  if (t.mode === 'text'){ if (t.text.length >= 12) return; t.text = t.text.slice(0, t.cur) + DIG[d] + t.text.slice(t.cur); t.cur++; }
  else if (t.mode === 'fixed'){ t.bits.shift(); t.bits.push(d); }
  else { if (t.text.length >= t.maxF) return; t.text += DIG[d]; }
  changed(t);
}
function backspace(){
  if (!S || !S.running) return;
  const t = act(); if (!t) return;
  if (t.mode === 'fixed'){ t.bits.pop(); t.bits.unshift(0); }
  else if (t.mode === 'text'){ if (!t.cur) return; t.text = t.text.slice(0, t.cur - 1) + t.text.slice(t.cur); t.cur--; }
  else t.text = t.text.slice(0, -1);
  changed(t);
}
function delForward(){
  if (!S || !S.running) return;
  const t = act(); if (!t) return;
  if (t.mode !== 'text'){ clearInput(); return; }
  if (t.cur >= t.text.length) return;
  t.text = t.text.slice(0, t.cur) + t.text.slice(t.cur + 1);
  changed(t);
}
function moveCaret(d, abs){
  if (!S || !S.running) return;
  const t = act(); if (!t || t.mode !== 'text') return;
  t.cur = abs ? (d < 0 ? 0 : t.text.length) : Math.max(0, Math.min(t.text.length, t.cur + d));
  render(t);
}
function clearInput(){
  if (!S || !S.running) return;
  const t = act(); if (!t) return;
  if (t.mode === 'fixed') t.bits.fill(0); else { t.text = ''; t.cur = 0; }
  render(t);
}
function submit(){
  if (!S || !S.running) return;
  const t = act(); if (!t) return;
  if (isCorrect(t)){ lock(t); return; }
  if (t.mode === 'fixed' ? !t.bits.some(Boolean) : !t.text) return;
  wrong(t);
}
function nope(t){ t.el.classList.add('nope'); setTimeout(() => t.el.classList.remove('nope'), 250); vibrate(15); }

function lock(t){
  if (t.state !== 'live') return;
  t.state = 'ok'; t.el.classList.add('ok');
  const dt = S.t - t.born, c = cfg(S.level);
  S.solved++; S.lvlSolved++; S.times.push(dt);
  const cs = catStat(t.cat); cs.n++; cs.t += dt;
  const speed = Math.max(0, 1 - dt / (c.spawn * 1.6));
  const cm = 1 + Math.min(S.combo, 10) * .1;
  const size = .6 + t.v.toString(2).length / 10;
  const pts = Math.round(WEIGHT[t.cat] * size * (1 + speed) * cm);
  advance(t, 1);
  S.combo++; S.bestCombo = Math.max(S.bestCombo, S.combo); S.score += pts;
  floater(t, '+' + pts); burst(t); vibrate(10);
  if (activeId === t.id) pickNext(t);
  const g = S.id;
  setTimeout(() => {
    if (!S || S.id !== g) return;
    t.el.classList.add('vanish');
    setTimeout(() => { if (!S || S.id !== g) return; removeTile(t); checkClean(); }, 420);
  }, 650);
  if (S.lvlSolved >= GOAL) levelUp();
  hud();
}
function wrong(t){
  t.wrong++; S.errors++; advance(t, -1); catStat(t.cat).e++; S.combo = 0; S.score = Math.max(0, S.score - 3);
  if (t.mode === 'fixed') t.bits.fill(0); else { t.text = ''; t.cur = 0; }
  if (t.wrong >= 2 && !t.helped){
    t.helped = true; t.hint = true;
    if (t.from === 2 && t.v < 256) t.weights = true;
    if (t.to === 2){
      t.mode = 'fixed'; t.width = Math.max(t.ans.length <= 4 ? 4 : 8, t.ans.length);
      t.bits = new Array(t.width).fill(0); t.weights = t.width <= 8;
    }
  }
  render(t);
  t.el.classList.remove('shake'); void t.el.offsetWidth; t.el.classList.add('shake');
  floater(t, '−3', 'bad'); vibrate(40); hud();
}

// ---------- Tiles lifecycle ----------
function spawn(){
  const live = tiles.filter(t => t.state === 'live').length;
  if (live >= G.cap){ gameOver(); return; }
  const t = makeTask(); t.slot = tiles.length;
  t.y = slotY(t.slot) - SPAWN_DROP; t.fallV = SPAWN_DROP / SPAWN_TIME;
  const el = document.createElement('div');
  el.className = 'tile new'; el.dataset.id = t.id; el.innerHTML = '<div class="card"></div>';
  el.style.transform = `translate3d(0,${t.y}px,0)`;
  t.el = el; tilesEl.appendChild(el); render(t); tiles.push(t);
  setTimeout(() => el.classList.remove('new'), 220);
  S.peak = Math.max(S.peak, live + 1);
  if (!act()) setActive(t);
}
function removeTile(t){
  const i = tiles.indexOf(t); if (i < 0) return;
  tiles.splice(i, 1); t.el.remove();
  tiles.forEach((x, j) => x.slot = j);
}
function checkClean(){
  if (!S || !S.running || tiles.length) return;
  if (S.peak >= 3){
    S.score += 30; S.peak = 0; hud();
    const f = document.createElement('div'); f.className = 'fl big'; f.textContent = 'Стакан чист! +30';
    f.style.top = (G.H * .55) + 'px'; fxEl.appendChild(f); setTimeout(() => f.remove(), 950);
  }
}
function levelUp(){
  S.level++; S.lvlSolved = 0; S.stage = 1; S.stageCnt = {}; S.dprog = {};
  if (S.level > store.maxLevel){ store.maxLevel = S.level; saveStore(); }
  showBanner('Уровень ' + S.level, cfg(S.level).desc);
  S.nextSpawn = Math.max(S.nextSpawn, 2.5);
}

// ---------- FX ----------
function floater(t, txt, cls = ''){
  const f = document.createElement('div'); f.className = 'fl ' + cls; f.textContent = txt;
  f.style.top = (t.y + G.tileH/2 - 14) + 'px'; fxEl.appendChild(f); setTimeout(() => f.remove(), 1000);
}
function burst(t){
  for (let i = 0; i < 10; i++){
    const b = document.createElement('span'); b.className = 'bit fam-' + t.fam;
    b.textContent = Math.random() < .5 ? '0' : '1';
    const a = Math.random() * Math.PI * 2, r = 40 + Math.random() * 60;
    b.style.left = (G.W * (.3 + Math.random() * .4)) + 'px';
    b.style.top = (t.y + G.tileH/2 - 8) + 'px';
    b.style.setProperty('--dx', (Math.cos(a) * r).toFixed(0) + 'px');
    b.style.setProperty('--dy', (Math.sin(a) * r - 24).toFixed(0) + 'px');
    fxEl.appendChild(b); setTimeout(() => b.remove(), 800);
  }
}
function showBanner(title, text){
  const b = $('#banner');
  b.querySelector('h3').textContent = title; b.querySelector('p').textContent = text;
  b.classList.remove('go'); void b.offsetWidth; b.classList.add('go');
}

// ---------- HUD ----------
function hud(){
  $('#hLvl').textContent = S ? S.level : 1;
  $('#hScore').textContent = S ? S.score : 0;
  $('#hCombo').textContent = '×' + (1 + Math.min(S ? S.combo : 0, 10) * .1).toFixed(1);
  $('#hBar').style.width = (S ? S.lvlSolved / GOAL * 100 : 0) + '%';
}

// ---------- Loop ----------
let last = performance.now();
function frame(now){
  const dt = Math.min(.05, (now - last) / 1000); last = now;
  if (S && S.running){
    S.t += dt; S.nextSpawn -= dt;
    { const a = act(); if (a) a.think += dt; }
    const live = tiles.filter(t => t.state === 'live').length;
    if (live === 0 && S.nextSpawn > .6) S.nextSpawn = .6;
    // новая плашка появляется только когда стакан «успокоился»: никто не растворяется и не оседает
    const calm = tiles.every(t => t.state === 'live' && t.y === slotY(t.slot));
    if (S.nextSpawn <= 0 && calm){
      S.nextSpawn = cfg(S.level).spawn * (.85 + Math.random() * .3);
      spawn();
    }
    for (const t of tiles){
      const ty = slotY(t.slot);
      if (t.y < ty){
        const v = t.dropping ? t.fallV : Math.max(260, (ty - t.y) * 14); // оседание: плавное замедление
        t.y = Math.min(ty, t.y + v * dt);
        if (ty - t.y < .5){ t.y = ty; t.dropping = false; }
      } else if (t.y > ty){ t.y = ty; t.dropping = false; }
      t.el.style.transform = `translate3d(0,${t.y.toFixed(1)}px,0)`;
    }
    wellEl.classList.toggle('danger', S.running && tiles.filter(t => t.state === 'live').length >= G.cap - 1);
  }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

// ---------- Game flow ----------
function startGame(level){
  if (S && !S.over) saveGame();
  tiles.forEach(t => t.el.remove()); tiles = []; activeId = null;
  fxEl.innerHTML = ''; wellEl.classList.remove('danger');
  S = newState(level);
  hideOverlays(); measure(); hud(); updateKeys();
  showBanner('Уровень ' + level, cfg(level).desc);
  last = performance.now();
}
function pause(){
  if (!S || !S.running) return;
  S.running = false;
  $('#pInfo').textContent = `Уровень ${S.level}, ${S.score} очков, решено ${S.solved}.`;
  show('ovPause');
}
function resume(){ if (!S || S.over) return; hideOverlays(); S.running = true; last = performance.now(); }
function gameOver(){
  S.running = false; S.over = true; wellEl.classList.remove('danger');
  tiles.forEach((t, i) => { t.el.style.transitionDelay = (i * 60) + 'ms'; t.el.classList.add('dead'); });
  const prevBest = store.best;
  saveGame();
  fillOver(S.score > prevBest && S.score > 0);
  setTimeout(() => show('ovOver'), 900);
}
function saveGame(){
  if (!S || S.saved || (S.solved + S.errors) === 0) return;
  S.saved = true;
  const at = S.solved ? S.times.reduce((a, b) => a + b, 0) / S.solved : 0;
  store.games.push({d:Date.now(), s:S.score, l:S.level, sl:S.startLevel, n:S.solved, e:S.errors,
    dur:Math.round(S.t), at:+at.toFixed(2), bc:S.bestCombo, c:S.cats});
  if (store.games.length > 300) store.games.splice(0, store.games.length - 300);
  store.best = Math.max(store.best, S.score);
  store.maxLevel = Math.max(store.maxLevel, S.level);
  saveStore();
}
function fillOver(record){
  $('#oBadge').innerHTML = record ? '<span class="badge">Новый рекорд!</span>' : '';
  $('#oScore').textContent = S.score;
  const acc = S.solved + S.errors ? Math.round(S.solved / (S.solved + S.errors) * 100) : 100;
  const at = S.solved ? S.times.reduce((a, b) => a + b, 0) / S.solved : 0;
  const cell = (v, l) => `<div class="cell"><strong>${v}</strong><span>${l}</span></div>`;
  $('#oGrid').innerHTML = cell(S.level, 'уровень') + cell(S.solved, 'решено') + cell(acc + '%', 'точность')
    + cell(fmtT(at) + ' с', 'в среднем') + cell(S.bestCombo, 'лучшая серия') + cell(store.best, 'рекорд');
  let note = '';
  const cs = Object.entries(S.cats);
  const errs = cs.filter(([, v]) => v.e > 0).sort((a, b) => b[1].e - a[1].e);
  const slow = cs.filter(([, v]) => v.n >= 2).sort((a, b) => b[1].t / b[1].n - a[1].t / a[1].n);
  if (errs.length) note = `Больше всего ошибок в переводе ${CATS[errs[0][0]]}. Попробуй начать с уровня ${CAT_LVL[errs[0][0]]} и потренировать именно его.`;
  else if (slow.length > 1) note = `Без ошибок! Медленнее всего получается ${CATS[slow[0][0]]} — в среднем ${fmtT(slow[0][1].t / slow[0][1].n)} с.`;
  $('#oNote').innerHTML = note ? `<div class="note">${note}</div>` : '';
}

// ---------- Overlays ----------
function hideOverlays(){ document.querySelectorAll('.ov').forEach(o => o.classList.remove('show')); overlay = null; }
function show(id){ hideOverlays(); $('#' + id).classList.add('show'); overlay = id; if (id === 'ovStart') renderChips(); }
function openStats(){
  if (S && S.running) { S.running = false; prevOverlay = 'ovPause'; $('#pInfo').textContent = `Уровень ${S.level}, ${S.score} очков, решено ${S.solved}.`; }
  else prevOverlay = overlay || 'ovStart';
  renderStats(); show('ovStats');
}
function renderChips(){
  const max = Math.min(store.maxLevel, LEVELS.length);
  if (startLevel > max) startLevel = 1;
  let h = '';
  for (let i = 1; i <= max; i++) h += `<button class="chip${i === startLevel ? ' on' : ''}" data-l="${i}">${i}</button>`;
  $('#chips').innerHTML = h;
}
$('#chips').addEventListener('click', e => {
  const b = e.target.closest('.chip'); if (!b) return;
  startLevel = +b.dataset.l; renderChips();
});
$('#bPlay').onclick = () => startGame(startLevel);
$('#bAgain').onclick = () => show('ovStart');
$('#bResume').onclick = resume;
$('#bRestart').onclick = () => { saveGame(); S.over = true; show('ovStart'); };
$('#bBack').onclick = () => show(prevOverlay || 'ovStart');
$('#bPause').onclick = () => { if (S && S.running) pause(); };
$('#bStats').onclick = openStats;
document.querySelectorAll('[data-stats]').forEach(b => b.onclick = openStats);
$('#bReset').onclick = () => {
  if (!confirm('Стереть всю историю игр и рекорды?')) return;
  store = defStore(); saveStore(); renderStats();
};

// ---------- Stats ----------
function lineChart(series, o = {}){
  const W = 320, H = o.h || 140, pl = 32, pr = 12, pt = 12, pb = 22;
  const vals = series.flatMap(s => s.data).filter(v => v != null && isFinite(v));
  if (vals.length < 2) return '<p class="empty">Сыграй хотя бы две игры, чтобы увидеть график.</p>';
  let mn = o.zero ? 0 : Math.min(...vals), mx = Math.max(...vals);
  if (mx - mn < 1e-9) mx = mn + 1;
  const pd = (mx - mn) * .08; if (!o.zero) mn = Math.max(0, mn - pd); mx += pd;
  const n = Math.max(...series.map(s => s.data.length));
  const X = i => pl + (n < 2 ? 0 : i * (W - pl - pr) / (n - 1));
  const Y = v => pt + (1 - (v - mn) / (mx - mn)) * (H - pt - pb);
  let g = '';
  for (let k = 0; k <= 3; k++){
    const v = mn + (mx - mn) * k / 3, y = Y(v).toFixed(1);
    g += `<line x1="${pl}" x2="${W-pr}" y1="${y}" y2="${y}"/><text x="${pl-6}" y="${+y+3}" text-anchor="end">${o.fmt ? o.fmt(v) : Math.round(v)}</text>`;
  }
  let p = '';
  for (const s of series){
    let d = '', on = false, pts = [];
    s.data.forEach((v, i) => {
      if (v == null || !isFinite(v)){ on = false; return; }
      d += (on ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1); on = true; pts.push([X(i), Y(v)]);
    });
    if (s.area && pts.length > 1)
      p += `<path class="area" d="M${pts[0][0].toFixed(1)} ${Y(mn).toFixed(1)}${pts.map(q => `L${q[0].toFixed(1)} ${q[1].toFixed(1)}`).join('')}L${pts[pts.length-1][0].toFixed(1)} ${Y(mn).toFixed(1)}Z"/>`;
    p += `<path class="${s.cls}" d="${d}"/>`;
    if (s.dot && pts.length){ const q = pts[pts.length-1]; p += `<circle class="${s.cls}" cx="${q[0].toFixed(1)}" cy="${q[1].toFixed(1)}" r="4"/>`; }
  }
  const xl = o.xl ? `<text x="${pl}" y="${H-6}">${o.xl[0]}</text><text x="${W-pr}" y="${H-6}" text-anchor="end">${o.xl[1]}</text>` : '';
  return `<svg class="ch" viewBox="0 0 ${W} ${H}" role="img"><g class="grid">${g}</g>${p}${xl}</svg>`;
}
function activityChart(games){
  const W = 320, H = 100, days = 14, day = 864e5;
  const t0 = new Date(); t0.setHours(0,0,0,0);
  const counts = new Array(days).fill(0);
  for (const r of games){
    const dd = new Date(r.d); dd.setHours(0,0,0,0);
    const k = days - 1 - Math.round((t0 - dd) / day);
    if (k >= 0 && k < days) counts[k] += r.n;
  }
  const mx = Math.max(1, ...counts), bw = (W - 8) / days;
  let h = '';
  counts.forEach((c, i) => {
    const bh = c ? Math.max(4, (H - 34) * c / mx) : 3;
    h += `<rect class="${c ? '' : 'zero'}" x="${(4 + i*bw + 2).toFixed(1)}" y="${(H - 16 - bh).toFixed(1)}" width="${(bw - 4).toFixed(1)}" height="${bh.toFixed(1)}" rx="3"/>`;
    if (c) h += `<text x="${(4 + i*bw + bw/2).toFixed(1)}" y="${(H - 19 - bh).toFixed(1)}" text-anchor="middle">${c}</text>`;
  });
  h += `<text x="4" y="${H-3}">2 недели назад</text><text x="${W-4}" y="${H-3}" text-anchor="end">сегодня</text>`;
  return `<svg class="ch" viewBox="0 0 ${W} ${H}" role="img">${h}</svg>`;
}
const dstr = ts => { const d = new Date(ts); return d.getDate().toString().padStart(2,'0') + '.' + (d.getMonth()+1).toString().padStart(2,'0'); };
function renderStats(){
  const el = $('#statsBody'), g = store.games;
  if (!g.length){ el.innerHTML = '<p class="empty">Здесь появится твой прогресс: очки, скорость и точность по каждому виду перевода. Сыграй первую игру!</p>'; return; }
  const total = g.reduce((a, r) => a + r.n, 0), errs = g.reduce((a, r) => a + r.e, 0);
  const acc = total + errs ? Math.round(total / (total + errs) * 100) : 100;
  const tsum = g.reduce((a, r) => a + r.at * r.n, 0);
  const cell = (v, l) => `<div class="cell"><strong>${v}</strong><span>${l}</span></div>`;
  let h = `<div class="grid3">${cell(g.length, 'игр')}${cell(store.best, 'рекорд')}${cell(store.maxLevel, 'макс. уровень')}${cell(total, 'решено всего')}${cell(acc + '%', 'точность')}${cell(total ? fmtT(tsum / total) + ' с' : '—', 'на задачу')}</div>`;

  const lastG = g.slice(-30), off = g.length - lastG.length;
  let run = 0; const bestSoFar = g.map(r => (run = Math.max(run, r.s)));
  h += `<h4>Очки по играм</h4>`;
  h += lastG.length < 2 ? '<p class="empty">Сыграй хотя бы две игры, чтобы увидеть график.</p>' : lineChart([{data:lastG.map(r => r.s), cls:'s1', area:true, dot:true}, {data:bestSoFar.slice(off), cls:'s2'}],
    {zero:true, xl:[dstr(lastG[0].d), dstr(lastG[lastG.length-1].d)]});
  h += `<div class="legend"><span><i style="background:var(--brand)"></i>очки</span><span><i style="background:var(--oct)"></i>рекорд на тот момент</span></div>`;

  h += `<h4>Среднее время на задачу, секунды (чем ниже, тем лучше)</h4>`;
  h += lastG.length < 2 ? '<p class="empty">Появится после второй игры.</p>' : lineChart([{data:lastG.map(r => r.n ? r.at : null), cls:'s3', dot:true}], {fmt:v => v.toFixed(1), xl:[dstr(lastG[0].d), dstr(lastG[lastG.length-1].d)]});

  h += `<h4>Решено задач по дням</h4>` + activityChart(g);

  // skills
  const agg = {};
  g.forEach((r, gi) => { for (const [k, v] of Object.entries(r.c || {})){
    const a = agg[k] || (agg[k] = {n:0, e:0, t:0, hist:[]});
    a.n += v.n; a.e += v.e; a.t += v.t; if (v.n) a.hist.push(v.t / v.n);
  }});
  const keys = Object.keys(CATS).filter(k => agg[k] && (agg[k].n + agg[k].e));
  if (keys.length){
    h += `<h4>Навыки: точность и время</h4>`;
    let worst = null, worstScore = -1;
    const avgAll = total ? tsum / total : 1;
    for (const k of keys){
      const a = agg[k], ac = a.n + a.e ? a.n / (a.n + a.e) : 1, avg = a.n ? a.t / a.n : 0;
      let tr = '';
      if (a.hist.length >= 4){
        const rec = a.hist.slice(-3), old = a.hist.slice(0, -3);
        const m = arr => arr.reduce((x, y) => x + y, 0) / arr.length;
        const r1 = m(rec), r0 = m(old);
        if (r1 < r0 * .93) tr = '<span class="tr up" title="быстрее, чем раньше">▼</span>';
        else if (r1 > r0 * 1.07) tr = '<span class="tr dn" title="медленнее, чем раньше">▲</span>';
      }
      h += `<div class="sk"><div class="sk-n">${CATS[k]}</div><div class="sk-b"><i style="width:${Math.round(ac*100)}%;${ac < .8 ? 'background:var(--oct)' : ''}"></i></div><div class="sk-a">${Math.round(ac*100)}%</div><div class="sk-t">${a.n ? fmtT(avg) + ' с' : '—'}${tr}</div></div>`;
      const sc = (1 - ac) * 3 + (a.n ? avg / avgAll : 0);
      if (a.n + a.e >= 3 && sc > worstScore){ worstScore = sc; worst = k; }
    }
    h += `<div class="legend"><span><span class="tr up">▼</span> быстрее, чем раньше</span><span><span class="tr dn">▲</span> медленнее</span></div>`;
    if (worst) h += `<div class="note" style="margin-top:14px">Над чем поработать: <b>${CATS[worst]}</b>. Этот перевод впервые появляется на уровне ${CAT_LVL[worst]}.</div>`;
  }
  el.innerHTML = h;
}

// ---------- Keypad ----------
const KEYS = ['1','2','3','A','B','4','5','6','C','D','7','8','9','E','F','bs','0','go'];
$('#keypad').innerHTML = KEYS.map(k => {
  if (k === 'bs') return `<button class="k bs" data-k="bs" aria-label="Стереть">⌫</button>`;
  if (k === 'go') return `<button class="k go wide" data-k="go" aria-label="Проверить">✓</button>`;
  return `<button class="k${/[A-F]/.test(k) ? ' hx' : ''}${k === '0' ? ' wide' : ''}" data-k="${k}">${k}</button>`;
}).join('');
function updateKeys(){
  const t = act(), base = t ? t.to : 0;
  document.querySelectorAll('#keypad .k').forEach(b => {
    const k = b.dataset.k;
    if (k === 'bs' || k === 'go') b.classList.toggle('off', !t);
    else b.classList.toggle('off', parseInt(k, 16) >= base);
  });
}
let bsTimer = null;
$('#keypad').addEventListener('pointerdown', e => {
  const b = e.target.closest('.k'); if (!b) return;
  e.preventDefault();
  b.classList.add('press'); setTimeout(() => b.classList.remove('press'), 110);
  const k = b.dataset.k;
  if (k === 'bs'){ backspace(); bsTimer = setTimeout(clearInput, 480); }
  else if (k === 'go') submit();
  else inputDigit(parseInt(k, 16));
});
['pointerup','pointercancel','pointerleave'].forEach(ev => $('#keypad').addEventListener(ev, () => clearTimeout(bsTimer)));

// ---------- Tile touch ----------
tilesEl.addEventListener('pointerdown', e => {
  if (!S || !S.running) return;
  const te = e.target.closest('.tile'); if (!te) return;
  const t = tiles.find(x => x.id === +te.dataset.id);
  if (!t || t.state !== 'live') return;
  e.preventDefault();
  if (activeId !== t.id) setActive(t);
  const fld = e.target.closest('.field');
  if (fld && t.mode === 'text'){
    const dg = e.target.closest('.dg');
    if (dg){ const r = dg.getBoundingClientRect(); t.cur = +dg.dataset.c + (e.clientX > r.left + r.width/2 ? 1 : 0); }
    else { const first = fld.querySelector('.dg'); t.cur = first && e.clientX < first.getBoundingClientRect().left ? 0 : t.text.length; }
    render(t); return;
  }
  const sq = e.target.closest('.a .sq'); if (!sq) return;
  if (t.mode === 'fixed'){ const i = +sq.dataset.i; t.bits[i] ^= 1; changed(t); }
  else if (t.mode === 'free'){
    if (sq.dataset.ghost){ if (t.text.length < t.maxF){ t.text += t.text ? '0' : '1'; changed(t); } }
    else { const i = +sq.dataset.i, a = t.text.split(''); a[i] = a[i] === '1' ? '0' : '1'; t.text = a.join(''); changed(t); }
  }
});

// ---------- Keyboard ----------
document.addEventListener('keydown', e => {
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  const k = e.key;
  if (overlay){
    if (k === 'Enter'){ const b = $('#' + overlay + ' [data-primary]'); if (b){ e.preventDefault(); b.click(); } }
    else if (k === 'Escape'){ if (overlay === 'ovStats') $('#bBack').click(); else if (overlay === 'ovPause') resume(); }
    return;
  }
  if (!S || !S.running) return;
  if (k === 'Escape' || k === 'p' || k === 'P' || k === 'з' || k === 'З'){ e.preventDefault(); pause(); return; }
  if (k === 'ArrowUp'){ e.preventDefault(); moveSel(1); return; }
  if (k === 'ArrowDown'){ e.preventDefault(); moveSel(-1); return; }
  if (k === 'Backspace' || e.code === 'Backspace'){ e.preventDefault(); backspace(); return; }
  if (k === 'Delete'){ e.preventDefault(); delForward(); return; }
  if (k === 'ArrowLeft'){ e.preventDefault(); moveCaret(-1); return; }
  if (k === 'ArrowRight'){ e.preventDefault(); moveCaret(1); return; }
  if (k === 'Home'){ e.preventDefault(); moveCaret(-1, true); return; }
  if (k === 'End'){ e.preventDefault(); moveCaret(1, true); return; }
  if (k === 'Enter' || k === ' '){ e.preventDefault(); submit(); return; }
  if (/^[0-9a-fA-F]$/.test(k)){ e.preventDefault(); inputDigit(parseInt(k, 16)); }
});
document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });
window.addEventListener('pagehide', () => { if (S && !S.over) saveGame(); });

// ---------- Init ----------
measure(); hud(); updateKeys(); show('ovStart');
})();
</script>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => { navigator.serviceWorker.register('sw.js').catch(() => {}); });
}
</script>
</body>
</html>
